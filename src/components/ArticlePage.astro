---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from './EvidenceBadge.astro';
import { articleCardImage, articlePath } from '../data/articles';
import { affiliateConfig, resolveAffiliateMode } from '../affiliate/config';
import { getArticleProductMapping } from '../affiliate/mappings';
import { productRegistry } from '../affiliate/registry';
import { mappingHasLiveProducts } from '../affiliate/render-policy';
import AffiliateDisclosure from './affiliate/AffiliateDisclosure.astro';
import RelatedBuyerGuideCTA from './affiliate/RelatedBuyerGuideCTA.astro';
import PlacementRenderer from './affiliate/PlacementRenderer.astro';
import { getPlacementPlan, type PlannedPlacement } from '../affiliate/placement-plan';
import { resolveFirstPlacementOffset } from '../affiliate/first-placement';

type ContentSegment = { type: 'html'; value: string } | { type: 'placement'; placement: PlannedPlacement; first: boolean };

type Article = CollectionEntry<'articles'>;

interface Props {
  article: Article;
  articles: Article[];
}

const { article, articles } = Astro.props;
const { Content, headings } = await render(article);
const href = articlePath(article);
const sectionLabel = article.data.section === 'guides' ? 'Guides' : 'Research';
const sectionHref = `/${article.data.section}/`;
const breadcrumbLabel = article.data.title.split(':')[0];
const requestedRelatedSlugs = [...new Set(article.data.relatedSlugs)].filter((slug) => slug !== article.data.slug);
const explicitRelated = requestedRelatedSlugs
  .map((slug) => articles.find((candidate) => candidate.data.slug === slug))
  .filter((candidate): candidate is Article => Boolean(candidate));
const related = (explicitRelated.length > 0 ? explicitRelated : articles
  .filter((candidate) => candidate.id !== article.id && (candidate.data.category === article.data.category || candidate.data.tags.some((tag: string) => article.data.tags.includes(tag)))))
  .slice(0, 3);
const published = article.data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const updated = article.data.updatedAt?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const pricingChecked = article.data.pricingChecked?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const image = typeof article.data.heroImage === 'string' ? article.data.heroImage : undefined;
const affiliateMode = resolveAffiliateMode(import.meta.env.AFFILIATE_MODE);
const affiliateMapping = getArticleProductMapping(article.data.slug);
const hasLiveAffiliateProducts = mappingHasLiveProducts(affiliateMapping, productRegistry, affiliateMode);
const showDraftAffiliatePreview = affiliateMode === 'draft'
  && article.data.slug === affiliateConfig.draftPilot.articleSlug
  && affiliateMapping?.primaryProductKeys.length === 1
  && affiliateMapping.primaryProductKeys[0] === affiliateConfig.draftPilot.productKey;
const showAffiliateBlock = hasLiveAffiliateProducts || showDraftAffiliatePreview;
const placementPlan = getPlacementPlan(article.data.slug);
// Split the rendered article HTML at H2 section boundaries and inject each planned
// placement at the end of its target section (a distributed commercial journey),
// without touching the prose. The FIRST placement is instead surfaced early —
// just after ~2 intro prose paragraphs — so it (and its disclosure) render high
// on the page; later placements keep their distributed section positions. Falls
// back to <Content /> when rendered HTML is unavailable (e.g. dev deferred rendering).
const renderedHtml = article.rendered?.html;
let contentSegments: ContentSegment[] | null = null;
if (showAffiliateBlock && placementPlan && renderedHtml) {
  const html = renderedHtml;
  const h2Offsets = [...html.matchAll(/<h2[\s>]/g)].map((match) => match.index ?? 0);
  const offsetForAnchor = (anchorIndex: number) => (anchorIndex + 1 < h2Offsets.length ? h2Offsets[anchorIndex + 1] : html.length);
  // The planned first unit is the earliest-anchored placement; move only that one
  // up to an early, structurally-safe prose boundary (never later than its
  // original section position). All other placements stay distributed.
  const firstPlacement = placementPlan.placements.reduce((earliest, candidate) =>
    candidate.anchorIndex < earliest.anchorIndex ? candidate : earliest, placementPlan.placements[0]);
  const injected = placementPlan.placements
    .map((placement) => {
      const sectionOffset = offsetForAnchor(placement.anchorIndex);
      if (placement === firstPlacement) {
        const earlyOffset = resolveFirstPlacementOffset(html, sectionOffset);
        return { placement, offset: earlyOffset ?? sectionOffset };
      }
      return { placement, offset: sectionOffset };
    })
    .sort((a, b) => a.offset - b.offset);
  const parts: ContentSegment[] = [];
  let cursor = 0;
  injected.forEach(({ placement, offset }, index) => {
    parts.push({ type: 'html', value: html.slice(cursor, offset) });
    parts.push({ type: 'placement', placement, first: index === 0 });
    cursor = offset;
  });
  parts.push({ type: 'html', value: html.slice(cursor) });
  contentSegments = parts;
}
const fallbackArticle = affiliateMapping?.relatedBuyerGuideSlug
  ? articles.find((candidate) => candidate.data.slug === affiliateMapping.relatedBuyerGuideSlug) : undefined;
const canonical = new URL(href, Astro.site);
const evidenceCopy = {
  'DOCUMENTED': 'Primary manufacturer documentation supports the core scope. Compatibility claims are not independent hands-on testing; verify the exact vehicle and function.',
  'MANUFACTURER CLAIM': 'The current scope depends on first-party product claims and is not presented as independent testing.',
  'COMMUNITY REPORTED': 'Repeated owner reports inform this page, but vehicle and software differences may change results.',
  'NEEDS VERIFICATION': 'Primary evidence is incomplete. Treat this as a research framework, not a final product conclusion.',
  'HANDS-ON VERIFIED': 'Use only when retained project evidence supports the exact statement and configuration.'
}[article.data.evidenceLevel];
const safetyCopy = article.data.safetyLevel === 'HIGH'
  ? 'Tool-selection guidance only: this article does not provide a universal service procedure. Vehicle-specific instructions, prerequisites, and professional escalation still matter.'
  : article.data.safetyLevel === 'MEDIUM'
    ? 'Use vehicle-specific instructions and understand the effect of any write or service operation.'
    : 'Low-risk research context; vehicle-specific verification still applies.';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt || article.data.publishedAt).toISOString(),
  author: { '@type': 'Organization', name: article.data.author },
  publisher: { '@type': 'Organization', name: 'Chassis Signal', url: Astro.site },
  mainEntityOfPage: canonical,
  ...(image ? { image: new URL(image, Astro.site) } : {})
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: sectionLabel, item: new URL(sectionHref, Astro.site) },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: canonical }
  ]
};
---
<BaseLayout title={article.data.seoTitle || article.data.title} description={article.data.description} image={image || null} type="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <header class="article-header shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={sectionHref}>{sectionLabel}</a><span>/</span><span aria-current="page">{breadcrumbLabel}</span></nav>
    <h1>{article.data.title}</h1>
    <p class="article-dek">{article.data.description}</p>
    <div class="article-meta"><span>Published {published}</span>{updated && <span>Updated {updated}</span>}{pricingChecked && <span>Pricing checked {pricingChecked}</span>}<span>{article.data.readingTime}</span><span>Safety / {article.data.safetyLevel}</span><EvidenceBadge level={article.data.evidenceLevel} /></div>
  </header>
  {article.data.showHero && image && <img class="article-hero-image" src={image} alt={article.data.heroAlt} width="1774" height="887" />}
  <div class:list={['article-layout', { 'article-layout--no-hero': !article.data.showHero }]}>
    <nav class="toc" aria-label="Table of contents"><strong>On this page</strong>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    <article class="prose">
      <div class="key-findings"><strong>Evidence & safety context</strong><p>{evidenceCopy} {safetyCopy}</p></div>
      {contentSegments
        ? contentSegments.map((part) => part.type === 'html'
            ? <Fragment set:html={part.value} />
            : <>
                {part.first && <AffiliateDisclosure compact />}
                <PlacementRenderer placement={part.placement} articleSlug={article.data.slug} />
              </>)
        : <>
            <Content />
            {showAffiliateBlock && affiliateMapping && placementPlan && <>
              <AffiliateDisclosure compact />
              {placementPlan.placements.map((placement) => <PlacementRenderer placement={placement} articleSlug={article.data.slug} />)}
            </>}
          </>}
      {!showAffiliateBlock && affiliateMapping?.monetizationMode === 'related_buyer_guide' && fallbackArticle && <RelatedBuyerGuideCTA
        href={articlePath(fallbackArticle)}
        title={fallbackArticle.data.title}
        rationale={affiliateMapping.recommendationRationale}
      />}
      {related.length > 0 && <section class="related">
        <h2>Related articles</h2>
        <div class="related-grid">{related.map((item) => <a class="related-card" href={articlePath(item)}>
          <span class:list={['related-card__visual', { 'related-card__visual--abstract': !articleCardImage(item) }]} style={articleCardImage(item) ? `--related-image:url(${articleCardImage(item)})` : undefined} aria-hidden="true"></span>
          <span class="related-card__body"><small>{item.data.category}</small><strong>{item.data.title}</strong><span>Read guide →</span></span>
        </a>)}</div>
      </section>}
    </article>
    <aside class="article-aside"><div class="evidence-panel"><h2>Evidence label</h2><EvidenceBadge level={article.data.evidenceLevel} /><p>{evidenceCopy}</p><h2 class="rail-heading">Safety</h2><p><strong>Safety / {article.data.safetyLevel}</strong><br />{safetyCopy}</p><h2 class="rail-heading">Testing status</h2><p>Documentation-based; no hands-on claim.</p></div><div class="research-note"><strong>Methodology</strong><p><a href="/methodology/">See how we classify evidence →</a></p></div></aside>
  </div>
</BaseLayout>
