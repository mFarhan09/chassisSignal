---
import EvidenceBadge from './EvidenceBadge.astro';
import { articleCardImage, articlePath } from '../data/articles';
interface Props {
  article: { id: string; data: { title: string; description: string; category: string; readingTime: string; evidenceLevel: string; slug: string; section: 'guides' | 'research'; heroImage?: string | { src: string } } };
  visual?: boolean;
}
const { article, visual = true } = Astro.props;
const href = articlePath(article);
const actionLabel = article.data.section === 'guides' ? 'Read guide' : 'Read research';
const cardImage = articleCardImage(article);
---
<article class="article-card card-3d" data-tilt>
  {visual && (cardImage
    ? <div class="article-card__visual article-card__visual--image" aria-hidden="true"><img src={cardImage} alt="" loading="lazy" decoding="async" /></div>
    : <div class="article-card__visual article-card__visual--abstract" aria-hidden="true"></div>
  )}
  <div class="article-card__meta"><span>{article.data.category}</span><EvidenceBadge level={article.data.evidenceLevel} /></div>
  <h3><a href={href}>{article.data.title}</a></h3>
  <p>{article.data.description}</p>
  <a class="text-link" href={href}>{actionLabel} <span aria-hidden="true">→</span></a>
</article>

<style>
  .article-card__visual--image img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
