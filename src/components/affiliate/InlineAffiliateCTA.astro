---
import { affiliateConfig, resolveAffiliateMode } from '../../affiliate/config';
import { getArticleProductMapping } from '../../affiliate/mappings';
import { getProduct } from '../../affiliate/registry';
import { getProductRenderState } from '../../affiliate/render-policy';
import AffiliateLink from '../AffiliateLink.astro';

interface Props {
  productKey: string;
  articleSlug: string;
  placement?: string;
  label?: (typeof affiliateConfig.allowedCtaLabels)[number];
  role?: string;
  context?: string;
}

const { productKey, articleSlug, placement = 'inline', label = affiliateConfig.allowedCtaLabels[1], role, context } = Astro.props;
const product = getProduct(productKey);
const mapping = getArticleProductMapping(articleSlug);
const state = getProductRenderState(product, mapping, resolveAffiliateMode(import.meta.env.AFFILIATE_MODE), import.meta.env.DEV);
const lead = context || product?.editorialSummary || 'Exact product link pending editorial review.';
---
{state.visible && product && <aside class="affiliate-inline-cta" data-affiliate-unit data-product-key={product.productKey} data-affiliate-relationship={mapping?.affiliateRelationship}>
  {state.draftPreview && <span class="affiliate-draft-badge">Draft preview · not clickable</span>}
  <div>{role && <p class="affiliate-inline-cta__role">{role}</p>}<strong>{product.brand} {product.model}</strong><p>{lead}</p></div>
  <AffiliateLink productKey={productKey} articleSlug={articleSlug} placement={placement} cardVariant="inline_cta" class="affiliate-button"><span>{state.draftPreview ? 'Amazon link awaiting verification' : label}</span></AffiliateLink>
</aside>}
