import VehicleCompatibilityEvidenceRules from '../../../components/VehicleCompatibilityEvidenceRules.astro';
const entries=[
 {generation:'E',task:'diagnosis',label:'E-series · diagnostic PC path',starting:'K+DCAN USB / approved K-line interface',verification:'Check early chassis double K-line requirement, software and module network',source:'https://www.bimmergeeks.net/faqs'},
 {generation:'E',task:'mobile',label:'E-series · owner app',starting:'Exact BimmerCode-listed Bluetooth or DCAN device',verification:'Early E-series and app platform may narrow supported adapters; check exact car',source:'https://bimmercode.app/adapters/'},
 {generation:'F',task:'mobile',label:'F-series · supported mobile app',starting:'ENET interface or approved BLE/Wi-Fi per app',verification:'App developer model lookup; phone Ethernet capability and available ECUs',source:'https://bimmercode.app/manual/'},
 {generation:'F',task:'diagnosis',label:'F-series · desktop diagnostics',starting:'ENET for supported diagnostic applications',verification:'Software and operation require a specific host/network interface',source:'https://bimmercode.app/adapters/'},
 {generation:'G',task:'mobile',label:'G-series · supported mobile app',starting:'App-approved ENET or supported adapter',verification:'Some G-series control units require particular adapter models; check software options',source:'https://bimmercode.app/manual/'},
 {generation:'G',task:'diagnosis',label:'G-series · professional diagnosis',starting:'BMW-approved interface; ICOM or compliant J2534 where supported',verification:'BMW AOS software requirements, access, vehicle and procedure',source:'https://bmwtechinfo.bmwgroup.com/assets/system_requirements.pdf'},
 {generation:'I',task:'mobile',label:'I-series · supported mobile coding',starting:'App-approved ENET or other listed adapter',verification:'BimmerCode vehicle model, supported ECU and operator platform',source:'https://bimmercode.app/adapters/'},
 {generation:'R',task:'diagnosis',label:'MINI R-series · diagnostic PC path',starting:'K+DCAN / supported older interface as applicable',verification:'Specific R chassis, K-line, connection/diagnostic software and equipped modules',source:'https://bimmercode.app/adapters/'},
