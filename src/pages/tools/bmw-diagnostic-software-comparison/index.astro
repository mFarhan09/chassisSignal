{name:'BimmerCode',type:'Feature and configuration coding',os:'iOS / Android / desktop (check current platform offering)',diagnostics:false,coding:true,service:false,workshop:false,source:'https://bimmercode.app/',limit:'Vehicle-option and module dependent; expert-mode risk'},
{name:'BimmerLink',type:'Diagnostics, live data and selected service functions',os:'iOS / Android',diagnostics:true,coding:false,service:true,workshop:false,source:'https://bimmerlink.app/',limit:'Function and installed-equipment dependent; not BimmerCode'},
{name:'Carly',type:'Diagnostics and selected coding / maintenance',os:'iOS / Android',diagnostics:true,coding:true,service:true,workshop:false,source:'https://www.mycarly.com/',limit:'Feature varies by model; check annual license and scanner terms'},
