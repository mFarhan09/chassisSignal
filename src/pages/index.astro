---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.filter((article) => article.data.featured).slice(0, 5);
const stories = [
  ['Architecture', 'Understanding BMW OBD architecture', 'Why BMW-specific diagnostics extends beyond generic emissions data.', '/images/research-workshop.jpg'],
  ['Buyer guide', 'Choosing an adapter for BimmerCode', 'Start with platform, chassis generation and the app’s documented support list.', '/images/adapter-study.jpg'],
  ['Explainer', 'Building a BMW diagnostic setup', 'Scanner, adapter or software: define the task before choosing the hardware.', '/images/coding-workspace.jpg'],
  ['Ownership cost', 'Scanner options without subscriptions', 'Separate up-front purchase, app licenses and recurring services.', '/images/scanner-workbench.jpg']
];
const tools = [
  ['BLE adapter', 'OBDLink CX', 'BimmerCode ecosystem focus'],
  ['Multi-platform', 'OBDLink MX+', 'Broad app ecosystem'],
  ['Value adapter', 'Veepeak BLE+', 'Compatibility-first research'],
  ['Handheld scanner', 'Foxwell NT530', 'BMW software package'],
  ['App ecosystem', 'Carly adapter', 'Subscription context']
];
---
<BaseLayout title="Chassis Signal" description="Independent BMW & MINI diagnostic scanner, coding adapter, software and compatibility research.">
  <section class="hero mobile-panel">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent. Technical. Trusted.</p>
        <h1>Smarter research <em>for BMW & MINI</em> owners.</h1>
        <p class="lede">Independent research into diagnostic scanners, coding adapters, apps, compatibility and service tools—built to make the evidence and the gaps equally clear.</p>
        <div class="hero-actions"><a class="button" href="/research/"><span>Browse research&nbsp; ↗</span></a><a class="button button--ghost" href="/comparisons/"><span>Compare tools&nbsp; →</span></a></div>
        <div class="trust-line"><span>Independent research</span><span>Clear compatibility</span><span>No-subscription focus</span><span>Evidence-led analysis</span></div>
      </div>
      <div class="diagnostic-stage" data-tilt aria-label="Conceptual diagnostic tool composition">
        <div class="stage-motion"><div class="stage-core">
          <img class="stage-photo" src="/images/research-workshop.jpg" alt="Diagnostic interface, cable and phone on a premium automotive workshop bench" width="1774" height="887" />
          <div class="chassis-line" aria-hidden="true"><svg viewBox="0 0 600 500" fill="none"><path d="M36 301C88 219 151 182 242 166l116-50 111 24 86 98 11 106-76 20-349 13-105-76Z" stroke="#75A4D1"/><path d="m129 251 109-68 121-45 90 25 61 77-121 5-97-60-163 66Z" stroke="#75A4D1"/><path d="M101 345c0-39 30-70 67-70s67 31 67 70m195 0c0-39 30-70 67-70s67 31 67 70M274 185l12 178m103-118-12 124M43 301l520 43" stroke="#75A4D1" stroke-dasharray="5 8"/><circle cx="168" cy="345" r="42" stroke="#75A4D1"/><circle cx="497" cy="345" r="42" stroke="#75A4D1"/></svg></div>
          <div class="device"><div class="device-screen"><small>Research interface</small><strong>Signal map</strong><div class="signal-bars"><i style="--h:42%"></i><i style="--h:66%"></i><i style="--h:54%"></i><i style="--h:82%"></i><i style="--h:70%"></i></div></div></div>
          <div class="adapter" aria-hidden="true"></div>
          <div class="data-float"><small>Conceptual compatibility layer</small><h2>Interface overview</h2><div class="data-row"><span>E-Series</span><b>Verify</b></div><div class="data-row"><span>F-Series</span><b>Documented</b></div><div class="data-row"><span>G-Series</span><b>Varies</b></div><div class="data-row"><span>MINI</span><b>Verify</b></div></div>
          <div class="stage-label">Decorative research interface</div>
        </div></div>
      </div>
    </div>
  </section>

  <section class="section section--tight mobile-panel" aria-labelledby="stories-title">
    <div class="shell section-head" data-reveal><div><p class="section-kicker">Current signals</p><h2 id="stories-title">Featured research stories.</h2></div><a class="text-link" href="/research/">Open the index <span>→</span></a></div>
    <div class="story-rail" data-reveal>{stories.map(([tag, title, copy, image]) => <a class="story card-3d" data-tilt style={`--story-image:url(${image})`} href="/research/"><small>{tag}</small><h3>{title}</h3><p>{copy}</p></a>)}</div>
  </section>

  <section class="section mobile-panel" id="categories">
    <div class="shell"><div class="section-head" data-reveal><div><p class="section-kicker">Browse by category</p><h2>One specialist research hub.</h2></div><p class="lede">Organized around the decision owners are actually trying to make.</p></div>
      <div class="category-index" data-reveal>{categories.map((category) => <a class="category-item card-3d" data-tilt href={category.href}><small>{category.index} / Index</small><span class="arrow">↗</span><div><h3>{category.title}</h3><p>{category.copy}</p></div></a>)}</div>
    </div>
  </section>

  <section class="section section--tight mobile-panel">
    <div class="shell"><div class="section-head" data-reveal><div><p class="section-kicker">Frequently researched tools</p><h2>Tools owners compare.</h2></div><a class="text-link" href="/methodology/">See our criteria <span>→</span></a></div>
      <div class="tool-rail" data-reveal><div class="tool-intro card-3d" data-tilt><div><p class="section-kicker">Research queue</p><h3>No unsupported winners.</h3><p>These are common comparison subjects, not awards or hands-on endorsements.</p></div><a class="text-link" href="/comparisons/">Compare the context <span>→</span></a></div>{tools.map(([category, name, copy]) => <article class="tool card-3d" data-tilt><div class="tool-visual"><div class="tool-object" aria-hidden="true"></div></div><small>{category}</small><h3>{name}</h3><p>{copy}</p><a href="/research/">View research →</a></article>)}</div>
    </div>
  </section>

  <section class="section matrix-section mobile-panel" id="comparison">
    <div class="shell matrix-layout"><div class="matrix-copy" data-reveal><p class="section-kicker">Comparison framework</p><h2>Compare the system, not the sticker.</h2><p>A useful comparison connects the vehicle, intended function, interface, software and ownership model. Values here demonstrate the factual framework; product-specific claims remain inside sourced research.</p><a class="button" href="/compatibility/"><span>Explore compatibility&nbsp; ↗</span></a></div>
      <div class="matrix-scroll" data-reveal><div class="matrix" role="table" aria-label="Diagnostic tool comparison dimensions"><div class="matrix-row matrix-row--head" role="row"><span>Dimension</span><span>Adapter</span><span>Handheld</span><span>Software</span></div><div class="matrix-row"><strong>Connection</strong><span class="value">BLE / Wi-Fi</span><span class="value">Cable</span><span class="value--varies">Varies</span></div><div class="matrix-row"><strong>Coding support</strong><span class="value--varies">App-dependent</span><span class="value--varies">Model-dependent</span><span class="value">Documented</span></div><div class="matrix-row"><strong>Diagnostics</strong><span class="value--varies">App-dependent</span><span class="value">Integrated</span><span class="value--varies">Interface-dependent</span></div><div class="matrix-row"><strong>Subscription</strong><span class="value--unknown">Not inherent</span><span class="value--unknown">Varies</span><span class="value--varies">License-dependent</span></div><div class="matrix-row"><strong>Compatibility</strong><span class="value--varies">Verify chain</span><span class="value--varies">Verify coverage</span><span class="value--varies">Verify version</span></div></div><p class="matrix-note">Framework values are categorical, not product ratings. Always verify current documentation for a specific vehicle and function.</p></div>
    </div>
  </section>

  <section class="section mobile-panel" id="methodology"><div class="shell method-grid"><div class="method-statement" data-reveal><p class="section-kicker">Methodology</p><h2>Research that shows its working.</h2><p>We separate official documentation, manufacturer claims, community evidence and unresolved questions. Strong conclusions require stronger evidence.</p><a class="text-link" href="/methodology/">Read our methodology <span>→</span></a></div><div class="method-steps" data-reveal><div class="method-step"><div><h3>Frame the owner’s question</h3><p>Vehicle, task, platform, budget and risk.</p></div></div><div class="method-step"><div><h3>Prioritize primary sources</h3><p>Official documentation and current compatibility lists.</p></div></div><div class="method-step"><div><h3>Map the full compatibility chain</h3><p>Chassis, interface, software and intended function.</p></div></div><div class="method-step"><div><h3>Label the evidence</h3><p>Claims and gaps remain visible instead of being smoothed over.</p></div></div><div class="method-step"><div><h3>Review safety and update</h3><p>Higher-risk procedures need better evidence and clearer prerequisites.</p></div></div></div></div></section>

  <section class="section mobile-panel"><div class="shell"><div class="section-head" data-reveal><div><p class="section-kicker">Latest research</p><h2>The current index.</h2></div><a class="text-link" href="/research/">View all research <span>→</span></a></div><div class="article-grid" data-reveal>{featured.map((article) => <ArticleCard article={article} />)}</div></div></section>
</BaseLayout>
