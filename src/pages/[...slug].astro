---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import { articleCardImage, articlePath, getPublishedArticles } from '../data/articles';
import { hubs, editorialPages } from '../data/site';
import type { Hub } from '../data/site';

export function getStaticPaths() {
  return [
    ...hubs.map((page) => ({ params: { slug: page.slug }, props: { kind: 'hub', page } })),
    ...editorialPages.map((page) => ({ params: { slug: page.slug }, props: { kind: 'editorial', page } }))
  ];
}
const { kind, page } = Astro.props;
type EditorialPage = (typeof editorialPages)[number];
const hubPage = kind === 'hub' ? page as Hub : undefined;
const editorialPage = kind === 'editorial' ? page as EditorialPage : undefined;
const articles = (await getPublishedArticles()).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const relevant = hubPage ? articles.filter((article) =>
  hubPage.slug === 'research' ||
  (hubPage.slug === 'guides' && article.data.section === 'guides') ||
  article.data.category.toLowerCase().includes(hubPage.title.split(' ')[0].toLowerCase()) ||
  article.data.tags.some((tag) => tag.toLowerCase().includes(hubPage.slug.replaceAll('-', ' ')))
) : [];
---
<BaseLayout title={page.title} description={page.intro}>
  <header class="page-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lede">{page.intro}</p></div><div class="page-index"><span>CS</span>{kind === 'hub' ? 'Research organized by decision, evidence and compatibility context.' : 'Publication standard — reviewed for clarity, independence and accuracy.'}</div></div></header>
  {kind === 'hub' ? <>
    <div class="focus-strip shell">{hubPage?.focus.map((focus: string, index: number) => <div><small>0{index + 1}</small>{focus}</div>)}</div>
    <section class="section"><div class="shell hub-layout"><aside class="hub-aside"><strong>In this index</strong><p>Published research will identify its evidence basis, limitations and compatibility context.</p><a href="/methodology/">Research methodology →</a><a href="/editorial-standards/">Evidence standards →</a><a href="/contact/">Contact status →</a></aside><div>
      {relevant.length ? <div class="hub-list">{relevant.map((article) => <article class:list={['hub-article card-3d', { 'hub-article--visual': hubPage?.slug === 'guides' }]} data-tilt>
        {hubPage?.slug === 'guides' && <a class:list={['hub-article__visual', { 'hub-article__visual--abstract': !articleCardImage(article) }]} href={articlePath(article)} style={articleCardImage(article) ? `--hub-image:url(${articleCardImage(article)})` : undefined} aria-label={`Read ${article.data.title}`}></a>}
        <small>{article.data.category}<br />{article.data.readingTime}</small>
        <div><h2><a href={articlePath(article)}>{article.data.title}</a></h2><p>{article.data.description}</p></div>
        <EvidenceBadge level={article.data.evidenceLevel} />
      </article>)}</div> : <div class="empty-state card-3d"><p class="section-kicker">Research queue</p><h2>Evidence gathering in progress.</h2><p>This section is intentionally quiet until the source set supports useful, specific research. No thin pages or invented conclusions have been published to fill the space.</p></div>}
      <div class="research-note"><strong>Compatibility note</strong><p>{hubPage?.note}</p></div>
    </div></div></section>
  </> : <section class="section"><div class="editorial-wrap"><div class="editorial-sections">{editorialPage?.sections.map(([title, copy]: readonly [string, string]) => <section class="editorial-section card-3d" data-tilt><h2>{title}</h2><p>{copy}</p></section>)}</div><div class="research-note"><strong>Corrections welcome</strong><p>Material errors can be reported through the <a href="/contact/">contact page</a>. Evidence is reviewed before changes are made.</p></div></div></section>}
</BaseLayout>
