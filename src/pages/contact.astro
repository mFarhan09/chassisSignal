---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact-channel status for Chassis Signal editorial corrections and enquiries." noindex>
  <header class="page-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">Contact the publication</p><h1>Send a useful signal.</h1><p class="lede">Chassis Signal is preparing a verified public contact channel. This page does not currently collect or deliver messages.</p></div><div class="page-index"><span>04</span>A monitored editorial channel will be published here when it is ready.</div></div></header>
  <section class="section contact-overview mobile-panel"><div class="shell"><p class="section-kicker">Future contact scope</p><h2>What the channel will cover.</h2><div class="contact-list"><div><strong>Editorial corrections</strong><span>The page, disputed claim and best available source.</span></div><div><strong>Product information</strong><span>Documentation changes, compatibility lists and specifications.</span></div><div><strong>Partnership enquiries</strong><span>The organization and proposed arrangement, clearly disclosed.</span></div><div><strong>General enquiries</strong><span>Publication feedback and accessibility issues.</span></div></div></div></section>
  <section class="section contact-form-section mobile-panel"><div class="shell contact-form-shell"><div class="empty-state card-3d"><p class="section-kicker">Contact status</p><h2>A verified channel is being prepared.</h2><p>No form submissions are collected by this site. Once a monitored editorial address or protected form is available, it will be published on this page.</p></div></div></section>
</BaseLayout>
