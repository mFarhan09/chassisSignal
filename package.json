{
  "name": "chassis-signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:live": "node scripts/release-live.mjs",
    "deploy:live": "node scripts/release-live.mjs --deploy",
    "preview": "astro preview",
    "check": "astro check",
    "qa:visual": "node scripts/affiliate-visual-qa.mjs",
    "affiliate:inventory": "node --experimental-strip-types scripts/affiliate-inventory.mjs",
    "affiliate:audit": "node --experimental-strip-types scripts/affiliate-rollout-audit.mjs",
    "affiliate:plan": "node --experimental-strip-types scripts/affiliate-placement-plan.mjs",
    "affiliate:diagnose": "node --experimental-strip-types scripts/affiliate-monetization-diagnosis.mjs",
    "affiliate:placements": "node --experimental-strip-types scripts/affiliate-placement-report.mjs",
    "test:affiliate": "pnpm affiliate:inventory && node --test --experimental-strip-types tests/affiliate-rollout.test.mjs tests/affiliate.test.mjs",
    "test": "pnpm test:affiliate",
    "typecheck": "astro check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.1",
    "astro": "^5.13.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.31.0"
  },
  "packageManager": "pnpm@10.14.0"
}
